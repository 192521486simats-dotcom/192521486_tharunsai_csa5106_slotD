#include <stdio.h>

// modular exponentiation
long long power(long long a, long long b, long long q) {
    long long result = 1;

    while(b > 0) {
        result = (result * a) % q;
        b--;
    }

    return result;
}

int main() {

    long long q, a;
    long long x, y;
    long long A, B;
    long long key1, key2;

    printf("Enter public prime q: ");
    scanf("%lld", &q);

    printf("Enter public base a: ");
    scanf("%lld", &a);

    printf("Enter Alice secret number x: ");
    scanf("%lld", &x);

    printf("Enter Bob secret number y: ");
    scanf("%lld", &y);


    // Alice sends A
    A = power(a, x, q);

    // Bob sends B
    B = power(a, y, q);


    // Shared keys
    key1 = power(B, x, q);
    key2 = power(A, y, q);


    printf("\nAlice sends: %lld", A);
    printf("\nBob sends: %lld", B);

    printf("\n\nAlice Shared Key: %lld", key1);
    printf("\nBob Shared Key: %lld\n", key2);


    if(key1 == key2)
        printf("\nKey exchange successful");

    else
        printf("\nKey exchange failed");


    return 0;
}
