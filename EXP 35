#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char plaintext[100], ciphertext[100], decrypted[100];
    int key[100];
    int n, i;

    printf("Enter plaintext: ");
    scanf("%s", plaintext);

    n = strlen(plaintext);

    printf("Enter key stream (%d numbers):\n", n);

    for(i = 0; i < n; i++)
        scanf("%d", &key[i]);


    // Encryption
    for(i = 0; i < n; i++)
    {
        char ch = tolower(plaintext[i]);

        ciphertext[i] =
        ((ch - 'a' + key[i]) % 26) + 'a';
    }

    ciphertext[n] = '\0';


    // Decryption
    for(i = 0; i < n; i++)
    {
        decrypted[i] =
        ((ciphertext[i] - 'a' - key[i] + 26) % 26) + 'a';
    }

    decrypted[n] = '\0';


    printf("\nCipher Text : %s", ciphertext);

    printf("\nDecrypted Text : %s\n", decrypted);


    return 0;
}
