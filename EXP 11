#include <stdio.h>
#include <math.h>

int main() {
    int i;
    double log2_25 = 0, log2_24 = 0;

    // log2(25!)
    for(i = 1; i <= 25; i++)
        log2_25 += log2(i);

    // log2(24!)
    for(i = 1; i <= 24; i++)
        log2_24 += log2(i);

    printf("Total possible keys (25!) ≈ 2^%.0f\n", log2_25);
    printf("Effective unique keys (24!) ≈ 2^%.0f\n", log2_24);

    return 0;
}
