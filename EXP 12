#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    int key[2][2] = {{9,4},{5,7}};
    int inv[2][2] = {{5,12},{15,25}}; // inverse key

    char text[200], clean[200], enc[200], dec[200];
    int i, j = 0;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    // remove spaces & convert to lowercase
    for(i = 0; text[i] != '\0'; i++) {
        if(isalpha(text[i])) {
            clean[j++] = tolower(text[i]);
        }
    }
    clean[j] = '\0';

    // make even length
    if(j % 2 != 0) {
        clean[j++] = 'x';
        clean[j] = '\0';
    }

    // ENCRYPTION
    for(i = 0; i < j; i += 2) {
        int a = clean[i] - 'a';
        int b = clean[i+1] - 'a';

        enc[i]   = ((key[0][0]*a + key[0][1]*b) % 26) + 'a';
        enc[i+1] = ((key[1][0]*a + key[1][1]*b) % 26) + 'a';
    }
    enc[j] = '\0';

    // DECRYPTION
    for(i = 0; i < j; i += 2) {
        int a = enc[i] - 'a';
        int b = enc[i+1] - 'a';

        dec[i]   = ((inv[0][0]*a + inv[0][1]*b) % 26) + 'a';
        dec[i+1] = ((inv[1][0]*a + inv[1][1]*b) % 26) + 'a';
    }
    dec[j] = '\0';

    printf("\nProcessed Text : %s", clean);
    printf("\nCipher Text    : %s", enc);
    printf("\nDecrypted Text : %s\n", dec);

    return 0;
}
