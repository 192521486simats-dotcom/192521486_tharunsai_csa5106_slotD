#include <stdio.h>

// simple XOR based CBC-MAC demonstration
int cbc_mac(int block, int key)
{
    return block ^ key;
}

int main()
{
    int key;
    int X;
    int T;
    int secondBlock;
    int forgedMAC;


    printf("Enter secret key: ");
    scanf("%d",&key);


    printf("Enter one block message X: ");
    scanf("%d",&X);


    // MAC of one block
    T = cbc_mac(X,key);


    printf("\nMAC(K,X) = %d",T);


    // attacker creates X || (X XOR T)
    secondBlock = X ^ T;


    printf("\nSecond block generated by attacker: %d",
            secondBlock);


    // CBC MAC of two blocks
    forgedMAC = cbc_mac(secondBlock,T);


    printf("\nForged MAC of X||(X XOR T): %d",
            forgedMAC);


    printf("\n\nAttack successful without knowing key");


    return 0;
}
