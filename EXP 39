#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 1000


char english[]="ETAOINSHRDLCUMWFGYPBVKJXQZ";


// calculate frequency
int mostFrequent(char text[])
{
    int count[26]={0};

    for(int i=0;text[i]!='\0';i++)
    {
        if(isalpha(text[i]))
        {
            count[toupper(text[i])-'A']++;
        }
    }


    int max=0,pos=0;

    for(int i=0;i<26;i++)
    {
        if(count[i]>max)
        {
            max=count[i];
            pos=i;
        }
    }

    return pos;
}


// decrypt with key
void decrypt(char cipher[], int key)
{
    for(int i=0;cipher[i]!='\0';i++)
    {
        if(isalpha(cipher[i]))
        {
            char c=toupper(cipher[i]);

            char p=((c-'A'-key+26)%26)+'A';

            printf("%c",p);
        }
        else
            printf("%c",cipher[i]);
    }

    printf("\n");
}


int main()
{
    char cipher[MAX];

    int top;


    printf("Enter cipher text: ");
    scanf(" %[^\n]",cipher);


    printf("Enter number of possible plaintexts: ");
    scanf("%d",&top);



    int freq=mostFrequent(cipher);


    // assume E is most frequent letter

    int key=(freq-'E'+26)%26;


    printf("\nPossible Plaintexts:\n");


    for(int i=0;i<top;i++)
    {
        printf("\n%d. Key = %d : ",i+1,(key+i)%26);

        decrypt(cipher,(key+i)%26);
    }


    return 0;
}
